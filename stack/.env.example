# ---- required secrets (generate: openssl rand -hex 32) ----
POSTGRES_PASSWORD=change-me
LITELLM_MASTER_KEY=sk-change-me
WEBUI_SECRET_KEY=change-me

# ---- optional ----
# Mac: leave unset (host Ollama via host.docker.internal). Linux profile: http://ollama:11434
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# MLX server on the host (OpenAI-compatible), if you run one
# OMLX_BASE_URL=http://host.docker.internal:8000/v1
# OMLX_API_KEY=

# Recto OCR endpoint for scanned PDFs (rag-ingest falls back to text-only PDFs if unset)
# RECTO_URL=http://host.docker.internal:9000/ocr

# Models as named in litellm/config.yaml
CHAT_MODEL=local/chat
EMBED_MODEL=local/embed

# Ports
WEBUI_PORT=3000
LITELLM_PORT=4000
RAG_PORT=8088

# Turn off after the first admin account exists
ENABLE_SIGNUP=True

# ---- Observability profile ----
# Set COMPOSE_PROFILES=obs to make `docker compose up -d` (and the keepalive agent) include it.
COMPOSE_PROFILES=obs
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
# Phone notifications for alerts. An ntfy topic (https://ntfy.sh/<long random name>), or a Slack or
# Discord webhook URL — alert-relay picks the payload shape from the URL. Unset = alerts are logged only.
# NTFY_URL=https://ntfy.sh/pick-something-long-and-random
# ALERT_WEBHOOK_URL=          # bypass alert-relay and send Grafana's raw JSON somewhere else
# PROMETHEUS_PORT=9090        # bound to 127.0.0.1 only
# METRICS_RETENTION=30d

# ---- A non-containerised app sharing this machine (optional) -------------------------------
# The reference machine also runs Gameplan, a private project whose cron pipelines are not
# containers, so their logs are read off the host filesystem instead. Point GAMEPLAN_DIR at that
# project to monitor it the same way; leave both unset and the scrape reports down while the rest
# of the stack is unaffected. See "Gameplan on the same machine" in stack/README.md.
WORKER_API_KEY=
GAMEPLAN_DIR=
