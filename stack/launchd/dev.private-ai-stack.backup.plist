<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.private-ai-stack.backup</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>__STACK__/scripts/backup.sh</string></array>
  <key>WorkingDirectory</key><string>__STACK__</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>KEEP</key><string>7</string>
  </dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/private-ai-stack.backup.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/private-ai-stack.backup.log</string>
</dict></plist>
