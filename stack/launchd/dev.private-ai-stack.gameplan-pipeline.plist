<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Gameplan's cron pipelines start, work and exit, so there is nothing for Prometheus to scrape while
  they run. This long-lived exporter reads the state files they leave behind and serves them on
  :9420, the same arrangement (and for the same reason) as the host-metrics agent.

  It runs from the LIVE gameplan checkout, which is what cron runs — so it exports the behaviour of
  the code that is actually in production, and picks up changes on the hourly git pull.

  No --env-file: the exporter needs no API key, no portal creds and no AI endpoint, and requiring
  them would mean an ops process that refuses to boot for reasons unrelated to its job.
-->
<plist version="1.0"><dict>
  <key>Label</key><string>dev.private-ai-stack.gameplan-pipeline</string>
  <key>ProgramArguments</key><array>
    <string>__HOME__/.bun/bin/bun</string>
    <string>run</string>
    <string>src/observability/exporter.ts</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/Development/gameplan/automation</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>__HOME__/.bun/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>METRICS_PORT</key><string>9420</string>
    <key>AUTOMATION_DIR</key><string>__HOME__/Development/gameplan/automation</string>
    <!-- crontab sends this one outside the repo; keep the two in step. -->
    <key>INTEGRATIONS_LOG</key><string>__HOME__/Desktop/integration.log</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/private-ai-stack.gameplan-pipeline.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/private-ai-stack.gameplan-pipeline.log</string>
</dict></plist>
