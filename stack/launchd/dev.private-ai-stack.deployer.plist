<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.private-ai-stack.deployer</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/python3</string>
    <string>__STACK__/deployer/deployer.py</string>
    <string>tick</string>
  </array>
  <key>WorkingDirectory</key><string>__STACK__</string>
  <key>EnvironmentVariables</key><dict>
    <!-- docker and gh (git's credential helper for private repos) live in Homebrew -->
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/private-ai-stack.deployer.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/private-ai-stack.deployer.log</string>
</dict></plist>
