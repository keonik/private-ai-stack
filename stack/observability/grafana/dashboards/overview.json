   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "spend"
     },
     "rawSql": "SELECT $__timeGroupAlias(\"startTime\", 1d), model_group AS metric, sum(spend) AS value FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\") GROUP BY 1, 2 ORDER BY 1",
     "format": "time_series"
    }
   ],
