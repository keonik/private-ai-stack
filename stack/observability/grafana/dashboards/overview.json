   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "min by (service) (probe_success{job=\"public\"})",
     "format": "time_series",
     "instant": true,
     "legendFormat": "{{service}}"
    }
   ],
   "description": "Each hostname in observability/prometheus/public-targets.json, fetched over the internet every 15 s. DOWN here with the service UP above means the tunnel is broken, not the app. A Cloudflare Access login page still counts as UP."
