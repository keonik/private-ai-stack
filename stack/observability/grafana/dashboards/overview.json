  {
   "id": 15,
   "type": "timeseries",
   "title": "Requests per hour, by model group",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "spend"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 40,
      "stacking": {
       "mode": "normal"
      },
      "showPoints": "never"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "spend"
     },
     "rawSql": "SELECT $__timeGroupAlias(\"startTime\", 1h), model_group AS metric, count(*) AS value FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\") GROUP BY 1, 2 ORDER BY 1",
     "format": "time_series"
    }
   ]
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "Time to first token p50, by model group",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "spend"
   },
   "gridPos": {
    "x": 8,
    "y": 24,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "spend"
     },
     "rawSql": "SELECT $__timeGroupAlias(\"startTime\", 1h), model_group AS metric, percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM (\"completionStartTime\" - \"startTime\"))) AS value FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\") AND \"completionStartTime\" IS NOT NULL AND call_type LIKE '%completion%' GROUP BY 1, 2 ORDER BY 1",
     "format": "time_series"
    }
   ],
   "description": "How long a user waits before the first word appears. The number people feel."
  },
  {
   "id": 17,
   "type": "timeseries",
