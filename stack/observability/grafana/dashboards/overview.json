      "uid": "spend"
     },
     "rawSql": "SELECT coalesce(nullif(metadata->>'user_api_key_alias', ''), left(api_key, 12)) AS key, model_group AS model, count(*) AS requests, sum(total_tokens) AS tokens, round(sum(spend)::numeric, 4) AS spend, round(avg(extract(epoch FROM (\"endTime\" - \"startTime\")))::numeric, 1) AS avg_s FROM \"LiteLLM_SpendLogs\" WHERE $__timeFilter(\"startTime\") GROUP BY 1, 2 ORDER BY tokens DESC LIMIT 25",
     "format": "table"
    }
   ]
  },
