  {
   "id": 8,
   "type": "timeseries",
   "title": "Requests per minute, by model",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqpm",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 40,
      "stacking": {
       "mode": "normal"
      },
      "showPoints": "never"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "sum by (requested_model) (rate(litellm_proxy_total_requests_metric_total{route=~\"/v1/.*|/chat/.*|/embeddings\"}[5m])) * 60",
     "legendFormat": "{{requested_model}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Latency p50 / p95, chat models",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 9,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never"
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.5, sum by (le, requested_model) (rate(litellm_request_total_latency_metric_bucket{requested_model!~\".*embed.*\"}[10m])))",
     "legendFormat": "p50 {{requested_model}}"
    },
    {
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     },
     "expr": "histogram_quantile(0.95, sum by (le, requested_model) (rate(litellm_request_total_latency_metric_bucket{requested_model!~\".*embed.*\"}[10m])))",
     "legendFormat": "p95 {{requested_model}}"
    }
   ],
   "description": "End-to-end request time through the router (includes queueing and generation)."
