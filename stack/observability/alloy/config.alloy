// Ship every compose container's stdout/stderr to Loki, labelled by service.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}
loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.default.receiver]
}
loki.write "default" {
  endpoint { url = "http://loki:3100/loki/api/v1/push" }
}

// ---- Gameplan's cron pipelines, which are not containers ----------------------------------
// The hourly download, nightly reconcile, integrations sweep and geometry shadow run under cron
// and exit, so there is no container stdout to follow — Alloy reads their log files off the host
// (mounted read-only in compose). The `pipeline` label is what the Gameplan dashboard filters on.
//
// These logs carry no timestamp Alloy can parse (the pipeline prints HH:mm:ss with no date), so
// entries are stamped with read time. Fine for "what happened just now"; do not read the first
// minutes after an Alloy restart as a burst of activity.
//
// The integrations cron is absent on purpose: crontab sends its output to ~/Desktop, which macOS
// privacy protection keeps out of the Docker VM. Its freshness is still tracked as a metric by the
// pipeline exporter, which runs on the host and can read it.
local.file_match "gameplan" {
  path_targets = [
    { __path__ = "/gameplan/automation/daily.log", job = "gameplan", pipeline = "daily" },
    { __path__ = "/gameplan/automation/reconcile.log", job = "gameplan", pipeline = "reconcile" },
    { __path__ = "/gameplan/automation/logs/shadow-cron.log", job = "gameplan", pipeline = "shadow" },
    { __path__ = "/gameplan/worker-logs/*/*.log", job = "gameplan", pipeline = "worker" },
  ]
}
loki.source.file "gameplan" {
  targets    = local.file_match.gameplan.targets
  forward_to = [loki.write.default.receiver]
}
